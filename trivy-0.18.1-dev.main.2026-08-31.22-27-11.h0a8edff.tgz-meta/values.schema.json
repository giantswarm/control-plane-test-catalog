{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as the `additionalProperties` setting would otherwise collide with Helm's special 'global' values key."
        },
        "kyvernoPolicyExceptions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "namespace": {
                    "type": "string"
                }
            }
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "ingress": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "namespaceSelector": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "podSelector": {
                            "type": "object",
                            "additionalProperties": false
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "subscriptionID": {
            "type": "string"
        },
        "trivy": {
            "type": "object",
            "additionalProperties": true
        },
        "verticalPodAutoscaler": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "trivy": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "containerPolicies": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        }
    }
}
