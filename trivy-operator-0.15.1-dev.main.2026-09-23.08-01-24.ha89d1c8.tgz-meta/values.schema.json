{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "scanJobExtraEgress": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "dnsSelector": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "rules": {
                                    "type": "array"
                                }
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "fqdnsConnection": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "port": {
                                    "type": "string"
                                },
                                "protocol": {
                                    "type": "string"
                                },
                                "rules": {
                                    "type": "array"
                                }
                            }
                        }
                    }
                }
            }
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "crds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "image": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "install": {
                    "type": "boolean"
                },
                "resources": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": "object",
            "description": "global values provide a centralized configuration for 'image.registry', reducing the potential for errors. If left blank, the chart will default to the individually set 'image.registry' values",
            "additionalProperties": false,
            "properties": {
                "image": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "registry": {
                            "type": "string"
                        }
                    }
                },
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enforced": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "registry": {
                    "type": "string"
                }
            }
        },
        "kyvernoPolicyExceptions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "namespace": {
                    "type": "string"
                }
            }
        },
        "managedBy": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "securityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "privileged": {
                    "type": "boolean"
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "serviceType": {
            "type": "string"
        },
        "subscriptionID": {
            "type": "string"
        },
        "trivy-operator": {
            "type": "object",
            "additionalProperties": true
        },
        "trivyServiceName": {
            "type": "string"
        },
        "trivyServicePort": {
            "type": "integer"
        },
        "verticalPodAutoscaler": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "trivyOperator": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "containerPolicies": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        }
    }
}
