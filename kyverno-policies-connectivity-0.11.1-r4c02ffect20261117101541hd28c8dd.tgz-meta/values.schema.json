{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "ip-range.json": {
            "type": "object",
            "required": [
                "start",
                "end"
            ],
            "additionalProperties": false,
            "properties": {
                "end": {
                    "type": "string"
                },
                "start": {
                    "type": "string"
                }
            }
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "certManager": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "sourceNamespace": {
                    "type": "string"
                },
                "syncSecret": {
                    "type": "boolean"
                },
                "targetNamespace": {
                    "type": "string"
                }
            }
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "name": {
                    "type": "string"
                },
                "proxy": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "http": {
                            "type": "string"
                        },
                        "https": {
                            "type": "string"
                        },
                        "noProxy": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "exclude": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "names": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "externalDNSIP": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "managementCluster": {
            "type": "string"
        },
        "provider": {
            "type": "string"
        },
        "proxy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "http": {
                    "type": "string"
                },
                "https": {
                    "type": "string"
                },
                "noProxy": {
                    "type": "string"
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "wcIpCheck": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "deriveFromControlPlaneEndpoint": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "number": {
                            "type": "integer"
                        },
                        "offset": {
                            "type": "integer"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "exclude": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "names": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "infraClusterNames": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "installJob": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kubectlImage": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "registry": {
                                    "type": "string"
                                },
                                "tag": {
                                    "type": "string"
                                }
                            }
                        },
                        "securityContext": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "runAsGroup": {
                                    "type": "integer"
                                },
                                "runAsUser": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                },
                "ipRanges": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ip-range.json"
                    }
                },
                "validationFailureAction": {
                    "type": "string",
                    "enum": [
                        "Audit",
                        "Enforce"
                    ]
                }
            }
        }
    }
}
