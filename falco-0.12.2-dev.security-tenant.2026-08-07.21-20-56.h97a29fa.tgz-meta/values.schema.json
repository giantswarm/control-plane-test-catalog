{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "properties": {
        "ciliumNetworkPolicy": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "falco": {
            "type": "object",
            "properties": {
                "collectors": {
                    "type": "object",
                    "properties": {
                        "kubernetes": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                },
                "controller": {
                    "type": "object",
                    "properties": {
                        "daemonset": {
                            "type": "object",
                            "properties": {
                                "updateStrategy": {
                                    "type": "object",
                                    "properties": {
                                        "rollingUpdate": {
                                            "type": "object",
                                            "properties": {
                                                "maxUnavailable": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "labels": {
                            "type": "object",
                            "properties": {
                                "application.giantswarm.io/team": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "customRules": {
                    "type": "object",
                    "properties": {
                        "gs-root-ca-key-access.yaml": {
                            "type": "string"
                        }
                    }
                },
                "driver": {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "type": "string"
                        },
                        "loader": {
                            "type": "object",
                            "properties": {
                                "initContainer": {
                                    "type": "object",
                                    "properties": {
                                        "image": {
                                            "type": "object",
                                            "properties": {
                                                "registry": {
                                                    "type": "string"
                                                },
                                                "repository": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "falco": {
                    "type": "object",
                    "properties": {
                        "json_output": {
                            "type": "boolean"
                        }
                    }
                },
                "falcoctl": {
                    "type": "object",
                    "properties": {
                        "image": {
                            "type": "object",
                            "properties": {
                                "registry": {
                                    "type": "string"
                                },
                                "repository": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "falcosidekick": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "registry": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        }
                    }
                },
                "k8s-metacollector": {
                    "type": "object",
                    "properties": {
                        "fullnameOverride": {
                            "type": "string"
                        },
                        "service": {
                            "type": "object",
                            "properties": {
                                "ports": {
                                    "type": "object",
                                    "properties": {
                                        "broker-grpc": {
                                            "type": "object",
                                            "properties": {
                                                "port": {
                                                    "type": "integer"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "metrics": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "outputRule": {
                            "type": "boolean"
                        }
                    }
                },
                "podLabels": {
                    "type": "object",
                    "properties": {
                        "observability.giantswarm.io/tenant": {
                            "type": "string"
                        }
                    }
                },
                "serviceAccount": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        }
                    }
                },
                "serviceMonitor": {
                    "type": "object",
                    "properties": {
                        "create": {
                            "type": "boolean"
                        },
                        "labels": {
                            "type": "object",
                            "properties": {
                                "application.giantswarm.io/team": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "tolerations": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "effect": {
                                "type": "string"
                            },
                            "key": {
                                "type": "string"
                            }
                        }
                    }
                },
                "tty": {
                    "type": "boolean"
                },
                "webserver": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "prometheus_metrics_enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "falcosidekick": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "registry": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        }
                    }
                },
                "serviceMonitor": {
                    "type": "object",
                    "properties": {
                        "additionalLabels": {
                            "type": "object",
                            "properties": {
                                "application.giantswarm.io/team": {
                                    "type": "string"
                                }
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "global": {
            "type": "object",
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "properties": {
                        "enforced": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "k8s-metacollector": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "registry": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        }
                    }
                },
                "serviceMonitor": {
                    "type": "object",
                    "properties": {
                        "create": {
                            "type": "boolean"
                        },
                        "interval": {
                            "type": "string"
                        },
                        "labels": {
                            "type": "object",
                            "properties": {
                                "application.giantswarm.io/team": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "kyvernoPolicyExceptions": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "namespace": {
                    "type": "string"
                }
            }
        },
        "verticalPodAutoscaler": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        }
    }
}
