{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as the `additionalProperties` setting would otherwise collide with Helm's special 'global' values key."
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "pullPolicy": {
                    "type": "string"
                },
                "registry": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "monitoring": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "podLogs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "annotations": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "relabelings": {
                            "type": "array"
                        },
                        "tenant": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "name": {
            "type": "string"
        },
        "postgres": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cnpg": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "clusterName": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "image": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "registry": {
                                    "type": "string"
                                },
                                "repository": {
                                    "type": "string"
                                },
                                "tag": {
                                    "type": "number"
                                }
                            }
                        },
                        "instances": {
                            "type": "integer"
                        },
                        "monitoring": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "grafanaDashboard": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "enabled": {
                                            "type": "boolean"
                                        }
                                    }
                                },
                                "podMonitor": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "enabled": {
                                            "type": "boolean"
                                        },
                                        "labels": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "properties": {
                                                "application.giantswarm.io/team": {
                                                    "type": "string"
                                                },
                                                "observability.giantswarm.io/tenant": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "storage": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "size": {
                                    "type": "string"
                                }
                            }
                        },
                        "switchoverDelay": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "reports-server": {
            "type": "object",
            "additionalProperties": true
        },
        "subscriptionID": {
            "type": "string"
        },
        "vpa": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "containerPolicies": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "minAllowed": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                }
            }
        }
    }
}
